# Vehicle Telemetry System - Production Environment Configuration

# Service Ports
DATA_INGESTION_PORT=8081
DATA_PROCESSING_PORT=8082
API_GATEWAY_PORT=8080

# Kafka Configuration (Production Cluster)
KAFKA_BOOTSTRAP_SERVERS=kafka-cluster-1:9092,kafka-cluster-2:9092,kafka-cluster-3:9092
KAFKA_TOPIC_TELEMETRY=vehicle-telemetry
KAFKA_CONSUMER_GROUP_ID=telemetry-processing-group
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2

# Cassandra Configuration (Production Cluster)
CASSANDRA_CONTACT_POINTS=cassandra-1,cassandra-2,cassandra-3
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=vehicle_telemetry
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_CONSISTENCY_LEVEL=QUORUM

# Logging Configuration (Production - Structured)
LOGGING_LEVEL_COM_VEHICLETELEMETRY=INFO
LOGGING_LEVEL_KAFKA=WARN
LOGGING_LEVEL_CASSANDRA=WARN
LOGGING_FORMAT=json
LOG_AGGREGATION_ENABLED=true

# Resource Configuration (Production - Optimized)
JAVA_OPTS=-Xmx2g -Xms1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200
KAFKA_HEAP_OPTS=-Xmx4g -Xms2g
CASSANDRA_MAX_HEAP_SIZE=4G
CASSANDRA_HEAP_NEWSIZE=800M

# Production Features
SPRING_PROFILES_ACTIVE=production
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_MOCK_DATA=false

# Monitoring (Production - Full Observability)
ENABLE_METRICS=true
METRICS_EXPORT_INTERVAL=10s
ENABLE_DISTRIBUTED_TRACING=true
HEALTH_CHECK_INTERVAL=30s

# Security (Production - Strict)
SECURITY_ENABLED=true
CORS_ALLOWED_ORIGINS=https://dashboard.vehicletelemetry.com
SSL_ENABLED=true
AUTHENTICATION_REQUIRED=true

# Performance Tuning
CONNECTION_POOL_SIZE=20
THREAD_POOL_SIZE=50
CIRCUIT_BREAKER_ENABLED=true
RATE_LIMITING_ENABLED=true

# Data Retention
DATA_RETENTION_DAYS=365
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
