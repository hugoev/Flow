# Vehicle Telemetry System - Development Environment Configuration

# Service Ports
DATA_INGESTION_PORT=8081
DATA_PROCESSING_PORT=8082
API_GATEWAY_PORT=8080

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=vehicle-telemetry
KAFKA_CONSUMER_GROUP_ID=telemetry-processing-group-dev

# Cassandra Configuration
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=vehicle_telemetry_dev
CASSANDRA_DATACENTER=datacenter1

# Logging Configuration
LOGGING_LEVEL_COM_VEHICLETELEMETRY=DEBUG
LOGGING_LEVEL_KAFKA=DEBUG
LOGGING_LEVEL_CASSANDRA=INFO

# Resource Configuration (Development - Lower Resources)
JAVA_OPTS=-Xmx512m -Xms256m
KAFKA_HEAP_OPTS=-Xmx256m -Xms128m
CASSANDRA_MAX_HEAP_SIZE=512M
CASSANDRA_HEAP_NEWSIZE=100M

# Development Features
SPRING_PROFILES_ACTIVE=development
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_MOCK_DATA=true

# Monitoring
ENABLE_METRICS=true
METRICS_EXPORT_INTERVAL=30s

# Security (Development - Relaxed)
SECURITY_ENABLED=false
CORS_ALLOWED_ORIGINS=*
