# Vehicle Telemetry System - Staging Environment Configuration
# Production-like environment for testing and validation

# Service Ports
DATA_INGESTION_PORT=8081
DATA_PROCESSING_PORT=8082
API_GATEWAY_PORT=8080

# Kafka Configuration (Staging Cluster)
KAFKA_BOOTSTRAP_SERVERS=kafka-staging-1:9092,kafka-staging-2:9092
KAFKA_TOPIC_TELEMETRY=vehicle-telemetry-staging
KAFKA_CONSUMER_GROUP_ID=telemetry-processing-group-staging
KAFKA_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=1

# Cassandra Configuration (Staging Cluster)
CASSANDRA_CONTACT_POINTS=cassandra-staging-1,cassandra-staging-2
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=vehicle_telemetry_staging
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_CONSISTENCY_LEVEL=LOCAL_QUORUM

# Logging Configuration (Staging - Detailed for Testing)
LOGGING_LEVEL_COM_VEHICLETELEMETRY=DEBUG
LOGGING_LEVEL_KAFKA=INFO
LOGGING_LEVEL_CASSANDRA=INFO
LOGGING_FORMAT=json
LOG_AGGREGATION_ENABLED=true

# Resource Configuration (Staging - Moderate Resources)
JAVA_OPTS=-Xmx1g -Xms512m -XX:+UseG1GC
KAFKA_HEAP_OPTS=-Xmx2g -Xms1g
CASSANDRA_MAX_HEAP_SIZE=2G
CASSANDRA_HEAP_NEWSIZE=400M

# Staging Features
SPRING_PROFILES_ACTIVE=staging
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_MOCK_DATA=false
ENABLE_TEST_DATA_GENERATION=true

# Monitoring (Staging - Full Monitoring for Testing)
ENABLE_METRICS=true
METRICS_EXPORT_INTERVAL=15s
ENABLE_DISTRIBUTED_TRACING=true
HEALTH_CHECK_INTERVAL=20s

# Security (Staging - Production-like but Relaxed)
SECURITY_ENABLED=true
CORS_ALLOWED_ORIGINS=https://staging.vehicletelemetry.com,http://localhost:4200
SSL_ENABLED=false
AUTHENTICATION_REQUIRED=false

# Performance Tuning (Staging - Moderate)
CONNECTION_POOL_SIZE=10
THREAD_POOL_SIZE=25
CIRCUIT_BREAKER_ENABLED=true
RATE_LIMITING_ENABLED=false

# Data Retention (Staging - Shorter Retention)
DATA_RETENTION_DAYS=30
BACKUP_ENABLED=false
