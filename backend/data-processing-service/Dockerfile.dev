# Development Dockerfile for Data Processing Service
# Includes Spring Boot DevTools for hot reloading
FROM openjdk:17-jdk-slim

# Install Maven and curl for health checks
RUN apt-get update && apt-get install -y maven curl && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy pom.xml first for better caching
COPY pom.xml .

# Download dependencies (this layer will be cached if pom.xml doesn't change)
RUN mvn dependency:go-offline -B

# Copy source code
COPY src src

# Build the application
RUN mvn clean compile

# Expose port
EXPOSE 8082

# Development command with hot reloading and optimized startup
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.jvmArguments='-Dspring.devtools.restart.enabled=true -Dspring.devtools.livereload.enabled=true -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200'"]
